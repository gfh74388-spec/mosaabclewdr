# ClewdR environment configuration (example)
# Copy this file to `.env` and fill your secrets.

# Service binding
CLEWDR_IP=0.0.0.0
CLEWDR_PORT=8484

# Passwords
# API password for clients (OpenAI Bearer / x-api-key / gemini ?key=...)
CLEWDR_PASSWORD=changeme-api
# Admin password for web console
CLEWDR_ADMIN_PASSWORD=changeme-admin

# Optional reverse proxy base (e.g., https://your.domain)
# CLEWDR_RPROXY=https://your.domain

# Optional upstream proxy (HTTP/SOCKS supported by wreq)
# CLEWDR_PROXY=http://user:pass@host:port

# Optional: pre-seed Claude cookies (array of arrays)
# Each inner array holds one cookie string.
# Example:
# CLEWDR_COOKIE_ARRAY=[["sk-ant-sid01-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXAAAAAA"],["sk-ant-sid01-YYYYYYYY..."]]
# Leave empty to add cookies from the admin UI later.
# CLEWDR_COOKIE_ARRAY=[]

# Optional: turn off update checks in container environments
CLEWDR_CHECK_UPDATE=false
CLEWDR_AUTO_UPDATE=false

# Filesystem persistence (recommended for the public image)
CLEWDR_NO_FS=false